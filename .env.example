# URLS
FRONTEND_URL="http://localhost:5173"

# SERVER CONFIG
PORT=3000
NODE_ENV=development

# DATABASE
# For local Docker MongoDB: mongodb://mongodb:27017/scholar-tool
# For MongoDB Atlas / External: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/scholar-tool
DB=mongodb://mongodb:27017/scholar-tool

# API KEYS
GEMINI_API_KEY=your_gemini_api_key_here
RESEND_API_KEY=your_resend_api_key

# JWT SECRETS
JWT_SECRET=your_jwt_secret_here
JWT_SECRET_ADMIN=your_jwt_admin_secret_here
JWT_SECRET_USER_INSTITUTION=your_jwt_institution_secret_here
JWT_SECRET_USER_TEACHER=your_jwt_teacher_secret_here
JWT_SECRET_USER_RESPONSABLE=your_jwt_responsable_secret_here
JWT_SECRET_USER_STUDENT=your_jwt_student_secret_here

# AUTHENTICATION DEFAULT SEEDERS
SEED_ROOT_EMAIL=""
SEED_ROOT_PASSWORD=""
SEED_INSTITUTION_NAME=""
SEED_INSTITUTION_EMAIL=""
SEED_INSTITUTION_PASSWORD=""
